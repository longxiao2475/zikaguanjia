<view class="page-shell review-page">
  <view wx:if="{{errorMessage}}" class="error-strip">{{errorMessage}}</view>

  <view wx:if="{{completed}}" class="complete-card surface-card">
    <view class="complete-card__icon">✓</view>
    <view class="complete-card__title">今天的复习完成啦</view>
    <view class="complete-card__text">已完成 {{total}} 张字卡，熟练度和复习次数已保存。</view>

    <view wx:if="{{showSubscribeCard}}" class="subscribe-card">
      <view class="subscribe-card__title">开启提醒，下次认字日准时通知</view>
      <view class="subscribe-card__text">微信每授权一次可增加 1 次有效提醒。</view>
      <button class="primary-button subscribe-card__primary" bindtap="onEnableReminder" loading="{{subscribing}}">开启提醒</button>
      <button class="text-button subscribe-card__later" bindtap="onDismissReminder">以后再说</button>
    </view>

    <button class="primary-button complete-card__button" bindtap="onBackHome">返回首页</button>
  </view>

  <block wx:elif="{{currentCard}}">
    <view class="review-progress">
      <view class="review-progress__line">
        <text>第 {{currentPosition}} / {{total}} 张</text>
        <view class="review-progress__right">
          <text>已标记 {{completedCount}} 张</text>
          <button
            wx:if="{{canReorder}}"
            class="review-progress__reorder"
            bindtap="onOpenOrderSheet"
          >调整顺序</button>
        </view>
      </view>
      <view class="review-progress__track">
        <view class="review-progress__value" style="width: {{progressPercent}}%;"></view>
      </view>
    </view>

    <button class="review-card surface-card" bindtap="onOpenWords">
      <view class="review-card__word">{{currentCard.content}}</view>
      <view class="review-card__hint">点字查看拼音和组词</view>
    </button>

    <view class="review-actions">
      <button
        class="review-action review-action--unfamiliar"
        data-proficiency="unfamiliar"
        bindtap="onMark"
        disabled="{{submitting}}"
      >不熟</button>
      <button
        class="review-action review-action--normal"
        data-proficiency="normal"
        bindtap="onMark"
        disabled="{{submitting}}"
      >一般</button>
      <button
        class="review-action review-action--proficient"
        data-proficiency="proficient"
        bindtap="onMark"
        disabled="{{submitting}}"
      >熟练</button>
    </view>

    <view wx:if="{{submitting}}" class="submission-status">正在保存整轮复习结果</view>
    <view wx:if="{{submissionError}}" class="submission-error surface-card">
      <view>{{submissionError}}</view>
      <button class="secondary-button submission-error__button" bindtap="onRetrySubmit">重新提交</button>
    </view>
  </block>

  <view wx:elif="{{!loading}}" class="surface-card empty-state">
    <view class="empty-state__title">今天没有待复习字卡</view>
    <view class="empty-state__text">录入新字后，系统会根据熟练度自动安排复习。</view>
    <button class="secondary-button review-empty__button" bindtap="onAddCard">录入新字</button>
  </view>

  <view wx:else class="surface-card review-loading">正在加载今日计划</view>

  <view wx:if="{{showWordDetail}}" class="word-detail-mask" bindtap="onCloseWords">
    <scroll-view class="word-detail-sheet" scroll-y enhanced show-scrollbar="{{false}}" catchtap="swallow">
      <view class="word-detail__handle"></view>
      <view
        class="word-detail__close"
        bindtap="onCloseWords"
        hover-class="word-detail__close--pressed"
        aria-role="button"
        aria-label="关闭字卡详情"
      >×</view>

      <view class="word-detail__title">“{{wordDetail.content}}”的单字详情</view>
      <view class="word-detail__helper">每个不重复的字分别显示拼音和组词</view>

      <view class="word-detail__group" wx:for="{{wordDetail.characters}}" wx:for-index="characterIndex" wx:key="character">
        <view class="word-detail__character-row">
          <view class="word-detail__character">{{item.character}}</view>
          <view wx:if="{{item.pinyin}}" class="word-detail__pinyin">{{item.pinyin}}</view>
        </view>

        <view class="word-detail__section-title">“{{item.character}}”的常用组词</view>
        <view wx:if="{{item.words.length}}" class="word-detail__tags">
          <view class="word-detail__tag" wx:for="{{item.words}}" wx:for-item="word" wx:key="*this">{{word}}</view>
        </view>
        <view wx:else class="word-detail__empty">暂时没有组词，可以在下方补充。</view>

        <view class="word-detail__input-row">
          <input
            class="word-detail__input"
            maxlength="12"
            placeholder="例如：包含“{{item.character}}”的词"
            value="{{item.inputValue}}"
            data-index="{{characterIndex}}"
            bindinput="onDetailWordInput"
            disabled="{{wordDetailSaving}}"
            cursor-color="#E6704A"
          />
          <button
            class="word-detail__save"
            data-index="{{characterIndex}}"
            bindtap="onSaveDetailWord"
            loading="{{wordDetailSaving}}"
            disabled="{{wordDetailSaving}}"
          >添加</button>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{showOrderSheet}}" class="order-sheet-mask" bindtap="onCloseOrderSheet">
    <view class="order-sheet" catchtap="swallow">
      <view class="order-sheet__handle"></view>
      <view
        class="order-sheet__close"
        bindtap="onCloseOrderSheet"
        hover-class="order-sheet__close--pressed"
        aria-role="button"
        aria-label="关闭顺序调整"
      >×</view>
      <view class="order-sheet__title">调整本轮复习顺序</view>
      <view class="order-sheet__helper">拖动整行排序，已复习的字卡不会改变</view>

      <movable-area class="order-sheet__area" style="height: {{orderAreaHeight}}px;">
        <movable-view
          class="order-sheet__item"
          wx:for="{{pendingOrderItems}}"
          wx:key="_id"
          direction="vertical"
          x="0"
          y="{{item.y}}"
          damping="30"
          friction="2"
          out-of-bounds="{{false}}"
          bindchange="onOrderDragChange"
        >
          <view
            class="order-sheet__item-content"
            data-index="{{index}}"
            bindtouchstart="onOrderDragStart"
            bindtouchend="onOrderDragEnd"
          >
            <view class="order-sheet__number">{{item.orderNumber}}</view>
            <view class="order-sheet__content">{{item.content}}</view>
            <view class="order-sheet__meta">{{index === 0 ? '下一张' : '待复习'}}</view>
            <view class="order-sheet__grip">☰</view>
          </view>
        </movable-view>
      </movable-area>
    </view>
  </view>
</view>
