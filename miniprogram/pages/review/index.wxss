.review-page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
}

.review-progress {
  padding: 12rpx 4rpx 26rpx;
}

.review-progress__line {
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  font-size: 25rpx;
}

.review-progress__right {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 14rpx;
}

.review-progress__reorder {
  min-width: 126rpx;
  min-height: 64rpx;
  padding: 0 18rpx;
  border-radius: 20rpx;
  color: var(--color-primary-dark);
  background: var(--color-primary-soft);
  font-size: 23rpx;
  font-weight: 650;
}

.review-progress__track {
  height: 16rpx;
  margin-top: 14rpx;
  border-radius: 8rpx;
  background: #EEE9E4;
  overflow: hidden;
}

.review-progress__value {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, var(--color-primary), var(--color-primary-dark));
  transition: width 180ms ease;
}

.review-card {
  width: 400rpx;
  height: 400rpx;
  margin: 28rpx auto 0;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.review-card__word {
  font-size: 120rpx;
  font-weight: 720;
  line-height: 1.15;
}

.review-card__hint {
  margin-top: 28rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
}

.review-actions {
  margin-top: 42rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.review-action {
  min-height: 150rpx;
  border-radius: 30rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 720;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(44, 44, 44, 0.12);
}

.review-action--unfamiliar {
  background: #EF5350;
}

.review-action--normal {
  background: #FFA726;
}

.review-action--proficient {
  background: #66BB6A;
}

.review-action[disabled] {
  opacity: 0.48;
}

.submission-status {
  margin-top: 24rpx;
  color: var(--color-text-secondary);
  text-align: center;
  font-size: 25rpx;
}

.submission-error {
  margin-top: 24rpx;
  padding: 24rpx;
  color: #A33B32;
  text-align: center;
}

.submission-error__button {
  width: 260rpx;
  margin: 20rpx auto 0;
}

.complete-card {
  margin-top: 56rpx;
  padding: 60rpx 40rpx;
  text-align: center;
}

.complete-card__icon {
  width: 118rpx;
  height: 118rpx;
  margin: 0 auto;
  border-radius: 59rpx;
  color: #FFFFFF;
  background: var(--color-proficient);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 68rpx;
  font-weight: 720;
}

.complete-card__title {
  margin-top: 28rpx;
  font-size: 40rpx;
  font-weight: 720;
}

.complete-card__text {
  margin-top: 14rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
}

.complete-card__button,
.review-empty__button {
  width: 290rpx;
  margin: 32rpx auto 0;
}

.subscribe-card {
  margin-top: 34rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: #FFF7E8;
  text-align: left;
}

.subscribe-card__title {
  color: #7D4B16;
  font-size: 29rpx;
  font-weight: 680;
}

.subscribe-card__text {
  margin-top: 8rpx;
  color: #946E45;
  font-size: 24rpx;
}

.subscribe-card__primary {
  width: 100%;
  margin-top: 22rpx;
}

.subscribe-card__later {
  width: 100%;
  margin-top: 8rpx;
  font-size: 25rpx;
}

.review-loading {
  margin-top: 24rpx;
  padding: 56rpx;
  color: var(--color-text-secondary);
  text-align: center;
}

.word-detail-mask,
.order-sheet-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  background: rgba(44, 44, 44, 0.42);
  display: flex;
  align-items: flex-end;
}

.word-detail-sheet,
.order-sheet {
  position: relative;
  width: 100%;
  height: 82vh;
  padding: 20rpx 34rpx calc(38rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #FFFFFF;
  box-sizing: border-box;
}

.order-sheet {
  height: auto;
  max-height: 82vh;
  overflow-y: auto;
}

.word-detail__handle,
.order-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 4rpx;
  background: #E4DFD9;
}

.word-detail__close,
.order-sheet__close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  color: #767676;
  background: #F6F3EF;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.word-detail__close--pressed,
.order-sheet__close--pressed {
  opacity: 0.72;
}

.word-detail__title,
.order-sheet__title {
  padding: 4rpx 92rpx 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

.word-detail__helper,
.order-sheet__helper {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  text-align: center;
  font-size: 23rpx;
}

.word-detail__group {
  margin-top: 26rpx;
  padding: 26rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 28rpx;
  background: #FCFBF9;
}

.word-detail__character-row {
  display: flex;
  align-items: baseline;
  gap: 22rpx;
}

.word-detail__character {
  font-size: 78rpx;
  font-weight: 720;
  line-height: 1.1;
}

.word-detail__pinyin {
  color: var(--color-primary-dark);
  font-size: 34rpx;
  font-weight: 650;
}

.word-detail__section-title {
  margin-top: 22rpx;
  font-size: 27rpx;
  font-weight: 680;
}

.word-detail__tags {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.word-detail__tag {
  min-height: 58rpx;
  padding: 8rpx 20rpx;
  border-radius: 29rpx;
  color: #7D3D2A;
  background: #FFF0EB;
  font-size: 25rpx;
  display: flex;
  align-items: center;
}

.word-detail__empty {
  margin-top: 12rpx;
  color: var(--color-text-muted);
  font-size: 24rpx;
}

.word-detail__input-row {
  margin-top: 20rpx;
  display: flex;
  gap: 14rpx;
}

.word-detail__input {
  min-width: 0;
  min-height: 88rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  color: var(--color-text);
  caret-color: var(--color-primary-dark);
  background: #FFFFFF;
  flex: 1;
  font-size: 27rpx;
}

.word-detail__save {
  width: 138rpx;
  min-height: 88rpx;
  border-radius: 24rpx;
  color: #FFFFFF;
  background: var(--color-primary-dark);
  font-size: 27rpx;
  font-weight: 650;
}

.word-detail__save[disabled] {
  opacity: 0.52;
}

.order-sheet__area {
  position: relative;
  width: 100%;
  margin-top: 28rpx;
}

.order-sheet__item {
  z-index: 1;
  width: 100%;
  height: 112rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 26rpx;
  background: #FCFBF9;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(83, 58, 42, 0.08);
}

.order-sheet__item--dragging {
  z-index: 10;
  border-color: rgba(230, 112, 74, 0.42);
  box-shadow: 0 18rpx 38rpx rgba(83, 58, 42, 0.18);
}

.order-sheet__item-content {
  width: 100%;
  height: 100%;
  padding: 18rpx 22rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 18rpx;
  transition: transform 160ms ease-out, background-color 160ms ease-out;
}

.order-sheet__item-content--dragging {
  background: #FFF9F6;
  transform: scale(1.015);
}

.order-sheet__number {
  width: 48rpx;
  height: 48rpx;
  border-radius: 24rpx;
  color: var(--color-primary-dark);
  background: var(--color-primary-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  font-size: 23rpx;
  font-weight: 700;
}

.order-sheet__content {
  min-width: 0;
  flex: 1;
  font-size: 38rpx;
  font-weight: 680;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.order-sheet__meta {
  color: var(--color-text-muted);
  font-size: 22rpx;
}

.order-sheet__grip {
  width: 60rpx;
  color: var(--color-text-secondary);
  text-align: center;
  font-size: 34rpx;
  letter-spacing: -4rpx;
}
