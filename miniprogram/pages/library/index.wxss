.library-page {
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.library-header {
  padding: 10rpx 4rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.library-header__title {
  font-size: 40rpx;
  font-weight: 720;
}

.library-header__text {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.library-header__add {
  min-width: 154rpx;
  padding: 0 24rpx;
  flex: 0 0 auto;
  font-size: 27rpx;
}

.library-tools {
  min-height: 88rpx;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.library-search {
  width: 100%;
  min-width: 0;
  height: 92rpx;
  margin-bottom: 12rpx;
  padding: 0 18rpx 0 24rpx;
  display: flex;
  align-items: center;
}

.library-search__input {
  width: 100%;
  height: 88rpx;
  min-width: 0;
  color: var(--color-text);
  caret-color: var(--color-primary-dark);
  flex: 1;
  font-size: 30rpx;
  line-height: 88rpx;
}

.library-search__placeholder {
  color: var(--color-text-muted);
}

.library-search__clear {
  min-width: 80rpx;
  color: var(--color-primary-dark);
  font-size: 23rpx;
}

.library-select {
  width: 180rpx;
  min-height: 76rpx;
  flex: 0 0 auto;
  font-size: 24rpx;
}

.library-tools__count {
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.filter-tabs {
  padding: 8rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8rpx;
}

.filter-tab {
  min-height: 82rpx;
  border-radius: 22rpx;
  color: var(--color-text-secondary);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.filter-tab--active {
  color: var(--color-primary-dark);
  background: var(--color-primary-soft);
}

.filter-tab__count {
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  border-radius: 17rpx;
  background: rgba(255, 255, 255, 0.76);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
}

.error-strip__action {
  min-width: 100rpx;
  min-height: 72rpx;
}

.card-list,
.library-loading {
  margin-top: 22rpx;
}

.word-card,
.skeleton-card {
  min-height: 126rpx;
  margin-bottom: 16rpx;
  padding: 24rpx 26rpx;
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.proficiency-dot,
.skeleton-card__dot {
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  flex: 0 0 auto;
}

.proficiency-dot--unfamiliar {
  background: var(--color-unfamiliar);
}

.proficiency-dot--normal {
  background: var(--color-normal);
}

.proficiency-dot--proficient {
  background: var(--color-proficient);
}

.word-card__main,
.skeleton-card__body {
  min-width: 0;
  flex: 1;
}

.word-card__selector-hit {
  width: 88rpx;
  height: 88rpx;
  margin: -22rpx -14rpx -22rpx -22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.word-card__selector {
  width: 38rpx;
  height: 38rpx;
  border: 2rpx solid #D7D1CB;
  border-radius: 50%;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  font-size: 23rpx;
  line-height: 38rpx;
}

.word-card__edit {
  width: 88rpx;
  min-width: 88rpx;
  height: 88rpx;
  margin: -12rpx -12rpx -12rpx 0;
  border-radius: 24rpx;
  color: var(--color-primary-dark);
  background: var(--color-primary-soft);
  flex: 0 0 auto;
  font-size: 24rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.word-card__edit--pressed {
  opacity: 0.72;
}

.word-card__selector--selected {
  border-color: var(--color-primary);
  background: var(--color-primary);
}

.word-card__topline {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.word-card__content {
  font-size: 40rpx;
  font-weight: 680;
  line-height: 1.25;
  word-break: break-all;
}

.word-card__type {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  color: var(--color-text-secondary);
  background: #F6F3EF;
  font-size: 21rpx;
}

.word-card__meta {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.library-empty {
  margin-top: 22rpx;
}

.library-empty__button {
  width: 300rpx;
  margin: 30rpx auto 0;
}

.load-more {
  padding: 22rpx 0 34rpx;
  color: var(--color-text-muted);
  text-align: center;
  font-size: 24rpx;
}

.selection-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(22rpx + env(safe-area-inset-bottom));
  z-index: 20;
  padding: 18rpx 20rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  box-shadow: 0 14rpx 38rpx rgba(83, 58, 42, 0.18);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.selection-bar__count {
  flex: 1;
  font-size: 27rpx;
  font-weight: 650;
}

.selection-bar__button {
  width: 240rpx;
}

.skeleton-card__dot {
  background: #F0ECE7;
}

.skeleton-card__line {
  width: 52%;
  height: 22rpx;
  margin-top: 16rpx;
  border-radius: 11rpx;
  background: #F0ECE7;
}

.skeleton-card__line--wide {
  width: 76%;
  height: 30rpx;
  margin-top: 0;
}

.edit-sheet-mask {
  position: fixed;
  z-index: 1100;
  inset: 0;
  background: rgba(44, 44, 44, 0.42);
  display: flex;
  align-items: flex-end;
}

.edit-sheet {
  width: 100%;
  padding: 20rpx 34rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #FFFFFF;
}

.edit-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 4rpx;
  background: #E4DFD9;
}

.edit-sheet__title {
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
}

.edit-sheet__label {
  margin-top: 30rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  font-weight: 600;
}

.edit-sheet__label--proficiency {
  margin-top: 28rpx;
}

.edit-sheet__input {
  width: 100%;
  height: 96rpx;
  margin-top: 10rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  color: var(--color-text);
  caret-color: var(--color-primary-dark);
  background: #FCFBF9;
  font-size: 34rpx;
}

.edit-sheet__helper {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 23rpx;
}

.edit-sheet__proficiencies {
  margin-top: 12rpx;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
}

.edit-sheet__proficiency {
  min-height: 88rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 24rpx;
  color: var(--color-text-secondary);
  font-size: 27rpx;
  font-weight: 650;
}

.edit-sheet__proficiency--unfamiliar.edit-sheet__proficiency--active {
  border-color: var(--color-unfamiliar);
  color: #B43835;
  background: #FFF0EE;
}

.edit-sheet__proficiency--normal.edit-sheet__proficiency--active {
  border-color: var(--color-normal);
  color: #A65A00;
  background: #FFF5E5;
}

.edit-sheet__proficiency--proficient.edit-sheet__proficiency--active {
  border-color: var(--color-proficient);
  color: #317A39;
  background: #EEF8EF;
}

.edit-sheet__actions {
  margin-top: 34rpx;
  display: grid;
  grid-template-columns: 1fr 1.5fr;
  gap: 16rpx;
}

.edit-sheet__delete,
.edit-sheet__save {
  min-height: 92rpx;
  border-radius: 26rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.edit-sheet__delete {
  color: #B43835;
  background: #FFF0EE;
}

.edit-sheet__cancel {
  width: 100%;
  min-height: 80rpx;
  margin-top: 8rpx;
}
