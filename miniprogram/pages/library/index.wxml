<view class="page-shell library-page">
  <view class="library-header">
    <view class="library-header__copy">
      <view class="library-header__title">孩子学过的字</view>
      <view class="library-header__text">按熟练度和复习时间自动排序</view>
    </view>
    <button class="secondary-button library-header__add" bindtap="onAddCard">+ 录入</button>
  </view>

  <view class="library-tools">
    <view class="library-tools__count">{{keyword ? '找到' : '当前'}} {{totalResults}} 张字卡</view>
    <button class="secondary-button library-select" bindtap="onToggleSelectionMode">
      {{selectionMode ? '取消选择' : '选择复习'}}
    </button>
  </view>

  <view class="library-filter-card surface-card">
    <view class="library-filter-search">
      <input
        class="library-search__input"
        value="{{keyword}}"
        placeholder="搜索字或词"
        placeholder-class="library-search__placeholder"
        cursor-color="#E6704A"
        confirm-type="search"
        bindinput="onKeywordInput"
        aria-label="搜索字卡名称"
      />
      <button wx:if="{{keyword}}" class="library-search__clear" bindtap="onClearKeyword">清除</button>
    </view>

    <view class="library-filter-section">
      <view class="library-filter-section__label">状态</view>
      <view class="filter-tabs">
        <button
          wx:for="{{tabs}}"
          wx:key="value"
          class="filter-tab {{selectedFilter === item.value ? 'filter-tab--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onSelectFilter"
          aria-role="radio"
          aria-checked="{{selectedFilter === item.value}}"
        >
          <text>{{item.label}}</text>
          <text class="filter-tab__count">{{item.count}}</text>
        </button>
      </view>
    </view>

    <view class="library-filter-section">
      <view class="library-filter-section__label">未复习</view>
      <view class="review-age-options">
        <button
          wx:for="{{reviewAgeOptions}}"
          wx:key="value"
          class="review-age-option {{reviewAgeDays === item.value ? 'review-age-option--active' : ''}}"
          data-days="{{item.value}}"
          bindtap="onSelectReviewAge"
          aria-role="radio"
          aria-checked="{{reviewAgeDays === item.value}}"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="library-filter-section library-filter-section--category">
      <button
        class="library-filter-category"
        bindtap="onOpenCategoryFilter"
        disabled="{{categoriesLoading}}"
        aria-label="选择字卡分类，当前{{categoryFilterSummary}}"
      >
        <view class="library-filter-category__label">分类</view>
        <view class="library-filter-category__value">{{categoriesLoading ? '加载中' : (categoryError ? '分类加载失败' : categoryFilterSummary)}}</view>
        <view class="library-filter-category__chevron">›</view>
      </button>
      <button wx:if="{{categoryError}}" class="category-filter-retry" bindtap="loadCategories">重试</button>
    </view>

    <view wx:if="{{hasActiveFilters}}" class="library-filter-actions">
      <view class="library-filter-actions__summary">已应用组合筛选</view>
      <button class="library-filter-clear" bindtap="onClearAllFilters">清空筛选</button>
    </view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-strip">
    <text>{{errorMessage}}</text>
    <button class="text-button error-strip__action" bindtap="onRetry">重试</button>
  </view>

  <view wx:if="{{loading}}" class="library-loading">
    <view class="surface-card skeleton-card" wx:for="{{skeletons}}" wx:key="*this">
      <view class="skeleton-card__dot"></view>
      <view class="skeleton-card__body">
        <view class="skeleton-card__line skeleton-card__line--wide"></view>
        <view class="skeleton-card__line"></view>
      </view>
    </view>
  </view>

  <view wx:elif="{{items.length}}" class="card-list">
    <view
      class="word-card-swipe"
      wx:for="{{items}}"
      wx:key="_id"
    >
      <view
        class="word-card-swipe__delete"
        data-id="{{item._id}}"
        catchtap="onSwipeDelete"
        aria-role="button"
        aria-label="删除{{item.content}}"
      >{{deletingCardId === item._id ? '删除中' : '删除'}}</view>
      <view
        class="word-card surface-card {{selectionMode && item.selected ? 'word-card--selected' : ''}} {{item.swipeOpen ? 'word-card--swipe-open' : ''}}"
        data-id="{{item._id}}"
        bindtap="onCardTap"
        bindtouchstart="onCardTouchStart"
        bindtouchend="onCardTouchEnd"
        hover-class="word-card--pressed"
        aria-role="{{selectionMode ? 'checkbox' : 'button'}}"
        aria-checked="{{selectionMode ? item.selected : false}}"
        aria-label="{{selectionMode ? (item.selected ? '取消选择' : '选择') : '查看'}}{{item.content}}"
      >
        <view
          wx:if="{{selectionMode}}"
          class="word-card__selector-hit"
        >
          <view class="word-card__selector {{item.selected ? 'word-card__selector--selected' : ''}}">{{item.selected ? '✓' : ''}}</view>
        </view>
        <view wx:else class="proficiency-dot proficiency-dot--{{item.proficiencyClass}}"></view>
        <view class="word-card__main">
          <view class="word-card__topline">
            <view class="word-card__content">{{item.content}}</view>
            <view class="word-card__type">{{item.typeLabel}}</view>
          </view>
          <view class="word-card__categories">
            <view class="word-card__category" wx:for="{{item.categoryLabels}}" wx:for-item="categoryLabel" wx:key="*this">{{categoryLabel}}</view>
            <view wx:if="{{item.categoryOverflowCount}}" class="word-card__category">+{{item.categoryOverflowCount}}</view>
            <view wx:if="{{!item.categoryLabels.length}}" class="word-card__category word-card__category--empty">未分类</view>
          </view>
          <view class="word-card__meta">{{item.proficiencyLabel}} · {{item.lastReviewLabel}} · 复习 {{item.reviewCount || 0}} 次</view>
        </view>
        <view
          wx:if="{{!selectionMode}}"
          class="word-card__edit"
          data-id="{{item._id}}"
          catchtap="onOpenEdit"
          hover-class="word-card__edit--pressed"
          aria-role="button"
          aria-label="编辑{{item.content}}"
        >编辑</view>
      </view>
    </view>
    <view wx:if="{{loadingMore}}" class="load-more">正在加载更多</view>
    <view wx:elif="{{!hasMore}}" class="load-more">已经到底了</view>
  </view>

  <view wx:else class="surface-card empty-state library-empty">
    <view class="empty-state__title">{{hasActiveFilters ? '没有符合筛选条件的字卡' : '还没有字卡'}}</view>
    <view class="empty-state__text">{{hasActiveFilters ? '可以调整名称、状态、未复习时间或分类，也可以清空全部筛选。' : '录入孩子今天新学的字，系统会自动安排复习。'}}</view>
    <button wx:if="{{hasActiveFilters}}" class="secondary-button library-empty__button" bindtap="onClearAllFilters">清空筛选</button>
    <button wx:else class="primary-button library-empty__button" bindtap="onAddCard">录入第一个字</button>
  </view>

  <view wx:if="{{selectionMode}}" class="selection-bar">
    <view class="selection-bar__count">已选 {{selectedCount}} 张</view>
    <button
      class="primary-button selection-bar__button"
      bindtap="onStartSelectedReview"
      disabled="{{selectedCount === 0}}"
    >开始复习</button>
  </view>

  <view wx:if="{{showWordDetail}}" class="word-detail-mask" bindtap="onCloseWordDetail">
    <scroll-view class="word-detail-sheet" scroll-y enhanced show-scrollbar="{{false}}" catchtap="swallow">
      <view class="word-detail__handle"></view>
      <view
        class="word-detail__close"
        bindtap="onCloseWordDetail"
        hover-class="word-detail__close--pressed"
        aria-role="button"
        aria-label="关闭字卡详情"
      >×</view>

      <view class="word-detail__title">“{{wordDetail.content}}”的单字详情</view>
      <view class="word-detail__helper">每个不重复的字分别显示拼音和组词</view>

      <view class="word-detail__group" wx:for="{{wordDetail.characters}}" wx:for-index="characterIndex" wx:key="character">
        <view class="word-detail__character-row">
          <view class="word-detail__character">{{item.character}}</view>
          <view wx:if="{{item.pinyin}}" class="word-detail__pinyin">{{item.pinyin}}</view>
        </view>

        <view class="word-detail__section-title">“{{item.character}}”的常用组词</view>
        <view wx:if="{{item.words.length}}" class="word-detail__tags">
          <view class="word-detail__tag" wx:for="{{item.words}}" wx:for-item="word" wx:key="*this">{{word}}</view>
        </view>
        <view wx:else class="word-detail__empty">暂时没有组词，可以在下方补充。</view>

        <view class="word-detail__input-row">
          <input
            class="word-detail__input"
            maxlength="12"
            placeholder="例如：包含“{{item.character}}”的词"
            value="{{item.inputValue}}"
            data-index="{{characterIndex}}"
            bindinput="onDetailWordInput"
            disabled="{{wordDetailSaving}}"
            cursor-color="#E6704A"
          />
          <button
            class="word-detail__save"
            data-index="{{characterIndex}}"
            bindtap="onSaveDetailWord"
            loading="{{wordDetailSaving}}"
            disabled="{{wordDetailSaving}}"
          >添加</button>
        </view>
      </view>
    </scroll-view>
  </view>

  <view wx:if="{{showEditSheet}}" class="edit-sheet-mask" bindtap="onCloseEdit">
    <view class="edit-sheet" catchtap="swallow">
      <view class="edit-sheet__handle"></view>
      <view class="edit-sheet__title">编辑字卡</view>

      <view class="edit-sheet__label">内容</view>
      <input
        class="edit-sheet__input"
        value="{{editContent}}"
        maxlength="20"
        bindinput="onEditContentInput"
        disabled="{{editSaving}}"
        cursor-color="#E6704A"
      />
      <view class="edit-sheet__helper">修改内容后，原来补充的组词会清空。</view>

      <view class="edit-sheet__label edit-sheet__label--proficiency">熟练度</view>
      <view class="edit-sheet__proficiencies">
        <button
          class="edit-sheet__proficiency edit-sheet__proficiency--unfamiliar {{editProficiency === 'unfamiliar' ? 'edit-sheet__proficiency--active' : ''}}"
          data-value="unfamiliar"
          bindtap="onSelectEditProficiency"
          disabled="{{editSaving}}"
        >不熟</button>
        <button
          class="edit-sheet__proficiency edit-sheet__proficiency--normal {{editProficiency === 'normal' ? 'edit-sheet__proficiency--active' : ''}}"
          data-value="normal"
          bindtap="onSelectEditProficiency"
          disabled="{{editSaving}}"
        >一般</button>
        <button
          class="edit-sheet__proficiency edit-sheet__proficiency--proficient {{editProficiency === 'proficient' ? 'edit-sheet__proficiency--active' : ''}}"
          data-value="proficient"
          bindtap="onSelectEditProficiency"
          disabled="{{editSaving}}"
        >熟练</button>
      </view>

      <view class="edit-sheet__label edit-sheet__label--category">所属分类</view>
      <button class="edit-sheet__category" bindtap="onOpenEditCategoryPicker" disabled="{{editSaving}}">
        <view class="edit-sheet__category-text">{{editCategorySummary}}</view>
        <view class="edit-sheet__category-action">修改</view>
      </button>

      <view class="edit-sheet__actions">
        <button class="edit-sheet__delete" bindtap="onDeleteCard" disabled="{{editSaving}}">删除字卡</button>
        <button class="primary-button edit-sheet__save" bindtap="onSaveEdit" loading="{{editSaving}}" disabled="{{editSaving}}">保存修改</button>
      </view>
      <button class="text-button edit-sheet__cancel" bindtap="onCloseEdit" disabled="{{editSaving}}">取消</button>
    </view>
  </view>

  <category-picker
    id="libraryCategoryFilterPicker"
    visible="{{showCategoryFilterPicker}}"
    title="筛选分类"
    categories="{{categories}}"
    selected-ids="{{pendingCategoryFilterIds}}"
    multiple="{{true}}"
    show-uncategorized="{{true}}"
    filter-mode="{{true}}"
    disabled="{{categorySaving}}"
    bindchange="onPendingCategoryFilterChange"
    bindconfirm="onConfirmCategoryFilter"
    bindclose="onCloseCategoryFilter"
    bindcreate="onCreateCategory"
    bindrename="onRenameCategory"
  />

  <category-picker
    id="libraryEditCategoryPicker"
    visible="{{showEditCategoryPicker}}"
    title="选择字卡分类"
    categories="{{categories}}"
    selected-ids="{{pendingEditCategoryIds}}"
    multiple="{{true}}"
    show-uncategorized="{{true}}"
    disabled="{{categorySaving || editSaving}}"
    bindchange="onPendingEditCategoryChange"
    bindconfirm="onConfirmEditCategoryPicker"
    bindclose="onCloseEditCategoryPicker"
    bindcreate="onCreateCategory"
    bindrename="onRenameCategory"
  />
</view>
