.home-page {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.hero-card {
  padding: 36rpx 34rpx;
  border-radius: 34rpx;
  color: #FFFFFF;
  background: linear-gradient(140deg, #FF9B7A 0%, #E6704A 100%);
  box-shadow: 0 18rpx 42rpx rgba(230, 112, 74, 0.24);
}

.hero-card__eyebrow {
  font-size: 25rpx;
  opacity: 0.86;
}

.hero-card__title {
  margin-top: 12rpx;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.35;
}

.hero-card__status {
  margin-top: 18rpx;
  font-size: 27rpx;
  opacity: 0.92;
}

.error-strip__action {
  flex: 0 0 auto;
  min-width: 100rpx;
  min-height: 72rpx;
}

.study-banner {
  margin-top: 24rpx;
  padding: 26rpx 28rpx;
  border-radius: 28rpx;
  color: #7D321D;
  background: linear-gradient(120deg, #FFF0D9, #FFE1D6);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.study-banner__title {
  font-size: 32rpx;
  font-weight: 700;
}

.study-banner__text {
  margin-top: 6rpx;
  color: #8E5B49;
  font-size: 25rpx;
}

.study-banner__action {
  flex: 0 0 auto;
  min-width: 118rpx;
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 36rpx;
  color: #FFFFFF;
  background: #E6704A;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 650;
}

.quota-banner {
  margin-top: 18rpx;
  padding: 24rpx 26rpx;
  border-color: #F5D69E;
  background: #FFF8E8;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.quota-banner__title {
  color: #7D4B16;
  font-size: 29rpx;
  font-weight: 700;
}

.quota-banner__text {
  margin-top: 5rpx;
  color: #946E45;
  font-size: 23rpx;
}

.quota-banner__action {
  flex: 0 0 auto;
  min-width: 126rpx;
  min-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 36rpx;
  color: #FFFFFF;
  background: #E69A32;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 650;
}

.overview-grid {
  margin-top: 24rpx;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16rpx;
}

.overview-item {
  padding: 26rpx 12rpx;
  text-align: center;
}

.overview-item__value {
  font-size: 42rpx;
  font-weight: 750;
  line-height: 1.2;
}

.overview-item__value--green {
  color: var(--color-proficient);
}

.overview-item__value--orange {
  color: var(--color-primary-dark);
}

.overview-item__label {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 24rpx;
}

.section-heading__title {
  margin-bottom: 0;
}

.section-heading__subtitle {
  margin-top: 5rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.section-heading__more {
  flex: 0 0 auto;
  min-height: 72rpx;
  font-size: 25rpx;
}

.review-list {
  margin-top: 18rpx;
  overflow: hidden;
}

.review-row {
  min-height: 112rpx;
  padding: 20rpx 26rpx;
  border-bottom: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.review-row:last-child {
  border-bottom: 0;
}

.proficiency-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex: 0 0 auto;
}

.proficiency-dot--unfamiliar {
  background: var(--color-unfamiliar);
}

.proficiency-dot--normal {
  background: var(--color-normal);
}

.proficiency-dot--proficient {
  background: var(--color-proficient);
}

.review-row__content {
  min-width: 0;
  flex: 1;
}

.review-row__word {
  font-size: 38rpx;
  font-weight: 650;
  line-height: 1.2;
}

.review-row__meta {
  margin-top: 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.review-row__chevron {
  color: var(--color-text-muted);
  font-size: 38rpx;
}

.quick-actions {
  margin-top: 28rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.quick-actions__button {
  width: 100%;
}

.empty-state__button {
  width: 290rpx;
  margin: 30rpx auto 0;
}

.floating-add {
  position: fixed;
  right: 34rpx;
  bottom: calc(42rpx + env(safe-area-inset-bottom));
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, var(--color-primary), var(--color-primary-dark));
  box-shadow: 0 14rpx 34rpx rgba(230, 112, 74, 0.32);
  font-size: 54rpx;
  font-weight: 300;
  line-height: 104rpx;
}

.floating-add:active {
  transform: scale(0.94);
}

.loading-card {
  margin-top: 18rpx;
  padding: 30rpx;
}

.loading-line {
  width: 54%;
  height: 24rpx;
  margin-top: 22rpx;
  border-radius: 12rpx;
  background: #F2EEE9;
}

.loading-line:first-child {
  margin-top: 0;
}

.loading-line--wide {
  width: 78%;
}
