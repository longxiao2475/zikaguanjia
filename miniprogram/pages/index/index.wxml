<view class="page-shell home-page">
  <view class="hero-card">
    <view class="hero-card__eyebrow">{{dateLabel}}</view>
    <view class="hero-card__title">{{greeting}}，{{childName}}的字卡准备好了</view>
    <view class="hero-card__status">{{isStudyDay ? '今天是认字日' : '今天可以轻松复习'}}</view>
  </view>

  <view wx:if="{{errorMessage}}" class="error-strip">
    <text>{{errorMessage}}</text>
    <button class="text-button error-strip__action" bindtap="onRetry">重试</button>
  </view>

  <view wx:if="{{showStudyBanner}}" class="study-banner tap-card" bindtap="onReview">
    <view>
      <view class="study-banner__title">今天该认字啦</view>
      <view class="study-banner__text">今日重点 {{plan.overview.due}} 个字，先从不熟的开始</view>
    </view>
    <view class="study-banner__action">去复习</view>
  </view>

  <view wx:if="{{showQuotaBanner}}" class="quota-banner surface-card">
    <view>
      <view class="quota-banner__title">提醒次数不足</view>
      <view class="quota-banner__text">当前剩余 {{subscriptionQuota}} 次，补充后认字日才能继续主动提醒。</view>
    </view>
    <button class="quota-banner__action" bindtap="onRequestReminderQuota" loading="{{subscribing}}">补充</button>
  </view>

  <view class="overview-grid">
    <view class="overview-item surface-card tap-card" data-filter="all" bindtap="onOpenLibrary">
      <view class="overview-item__value">{{plan.overview.total}}</view>
      <view class="overview-item__label">总字数</view>
    </view>
    <view class="overview-item surface-card tap-card" data-filter="mastered" bindtap="onOpenLibrary">
      <view class="overview-item__value overview-item__value--green">{{plan.overview.mastered}}</view>
      <view class="overview-item__label">已掌握</view>
    </view>
    <view class="overview-item surface-card tap-card" data-filter="due" bindtap="onOpenLibrary">
      <view class="overview-item__value overview-item__value--orange">{{plan.overview.due}}</view>
      <view class="overview-item__label">待复习</view>
    </view>
  </view>

  <view class="section-heading">
    <view>
      <view class="section-title section-heading__title">今日待复习</view>
      <view class="section-heading__subtitle">不熟优先，同档越久没复习越靠前</view>
    </view>
    <button class="text-button section-heading__more" data-filter="all" bindtap="onOpenLibrary">全部字卡</button>
  </view>

  <view wx:if="{{showSkeleton}}" class="surface-card loading-card">
    <view class="loading-line loading-line--wide"></view>
    <view class="loading-line"></view>
    <view class="loading-line"></view>
  </view>

  <view wx:elif="{{previewCards.length}}" class="review-list surface-card">
    <view
      class="review-row tap-card"
      wx:for="{{previewCards}}"
      wx:key="_id"
      bindtap="onReview"
    >
      <view class="proficiency-dot proficiency-dot--{{item.proficiencyClass}}"></view>
      <view class="review-row__content">
        <view class="review-row__word">{{item.content}}</view>
        <view class="review-row__meta">{{item.proficiencyLabel}} · 上次复习：{{item.lastReviewLabel}}</view>
      </view>
      <view class="review-row__chevron">›</view>
    </view>
  </view>

  <view wx:else class="surface-card empty-state">
    <view class="empty-state__title">还没有待复习字卡</view>
    <view class="empty-state__text">先录入孩子今天新学的字，之后会自动排进复习计划。</view>
    <button class="secondary-button empty-state__button" bindtap="onAddCard">录入第一个字</button>
  </view>

  <view class="quick-actions">
    <button class="primary-button quick-actions__button" bindtap="onAddCard">录入新字</button>
    <button class="secondary-button quick-actions__button" bindtap="onReview" disabled="{{plan.overview.due === 0}}">开始复习</button>
  </view>

  <view
    class="floating-add"
    bindtap="onAddCard"
    hover-class="floating-add--pressed"
    aria-role="button"
    aria-label="快速录入字卡"
  >+</view>
</view>
