.settings-intro {
  padding: 10rpx 4rpx 24rpx;
}

.settings-intro__title {
  font-size: 40rpx;
  font-weight: 720;
}

.settings-intro__text {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.settings-card {
  overflow: hidden;
}

.settings-row {
  min-height: 138rpx;
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-row__label {
  font-size: 29rpx;
  font-weight: 650;
}

.settings-row__helper {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.settings-row__value {
  flex: 0 0 auto;
  color: var(--color-primary-dark);
  font-size: 27rpx;
  font-weight: 620;
}

.settings-row__value--wrap {
  max-width: 250rpx;
  text-align: right;
}

.version-text {
  margin-top: 46rpx;
  color: var(--color-text-muted);
  text-align: center;
  font-size: 23rpx;
}
