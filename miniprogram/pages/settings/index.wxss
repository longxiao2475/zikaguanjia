.settings-intro {
  padding: 10rpx 4rpx 24rpx;
}

.settings-intro__title {
  font-size: 40rpx;
  font-weight: 720;
}

.settings-intro__text {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
}

.settings-card {
  overflow: hidden;
}

.settings-block,
.settings-row {
  padding: 26rpx 28rpx;
  border-bottom: 2rpx solid var(--color-border);
}

.settings-row {
  min-height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 28rpx;
}

.settings-row:last-child {
  border-bottom: 0;
}

.settings-block__label,
.settings-row__label {
  font-size: 29rpx;
  font-weight: 650;
}

.settings-block__helper,
.settings-row__helper,
.quota-card__helper {
  margin-top: 6rpx;
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.settings-input {
  min-height: 88rpx;
  margin-top: 14rpx;
  padding: 0 22rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 22rpx;
  background: #FAF8F5;
  font-size: 28rpx;
}

.day-picker {
  margin-top: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.day-picker__item {
  width: 68rpx;
  height: 68rpx;
  border-radius: 34rpx;
  color: var(--color-text-secondary);
  background: #F4F1ED;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 68rpx;
  font-size: 25rpx;
}

.day-picker__item--selected {
  color: #FFFFFF;
  background: var(--color-primary);
  box-shadow: 0 8rpx 18rpx rgba(230, 112, 74, 0.22);
}

.settings-row__value {
  min-height: 72rpx;
  color: var(--color-primary-dark);
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 650;
}

.quota-card {
  margin-top: 22rpx;
  padding: 26rpx 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quota-card__label {
  font-size: 29rpx;
  font-weight: 650;
}

.quota-card__value {
  color: var(--color-primary-dark);
  font-size: 48rpx;
  font-weight: 750;
}

.settings-save {
  width: 100%;
  margin-top: 28rpx;
}

.quota-grant {
  width: 100%;
  margin-top: 16rpx;
}

.family-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.family-card__heading,
.family-code-row,
.family-preview__actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.family-card__role {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  color: var(--color-primary-dark);
  background: var(--color-primary-light);
  font-size: 22rpx;
}

.family-invite,
.family-join {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}

.family-action {
  width: 100%;
  margin-top: 14rpx;
}

.family-code-row {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: #FAF8F5;
}

.family-code {
  letter-spacing: 8rpx;
  color: var(--color-primary-dark);
  font-size: 34rpx;
  font-weight: 750;
}

.family-code-input {
  text-transform: uppercase;
}

.family-preview-mask {
  position: fixed;
  z-index: 40;
  inset: 0;
  padding: 32rpx;
  background: rgba(35, 31, 28, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.family-preview {
  width: 100%;
  max-width: 650rpx;
  padding: 32rpx;
}

.family-preview__title {
  font-size: 34rpx;
  font-weight: 720;
}

.family-preview__text,
.family-preview__hint {
  margin-top: 18rpx;
  color: var(--color-text-secondary);
  font-size: 25rpx;
  line-height: 1.6;
}

.family-preview__stats {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 18rpx;
  background: #FAF8F5;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
  text-align: center;
  font-size: 23rpx;
}

.family-preview__actions {
  margin-top: 26rpx;
}

.family-preview__actions button {
  min-width: 0;
  flex: 1;
}
