<view wx:if="{{visible}}" class="word-sheet-mask" bindtap="onClose">
  <view class="word-sheet" catchtap="swallow">
    <view class="word-sheet__handle"></view>
    <button class="word-sheet__close" bindtap="onClose" aria-label="关闭组词面板">×</button>

    <view class="word-sheet__word">{{detail.content}}</view>
    <view wx:if="{{detail.pinyin}}" class="word-sheet__pinyin">{{detail.pinyin}}</view>

    <view class="word-sheet__section-title">常用组词</view>
    <view wx:if="{{detail.words.length}}" class="word-sheet__tags">
      <view class="word-sheet__tag" wx:for="{{detail.words}}" wx:key="*this">{{item}}</view>
    </view>
    <view wx:else class="word-sheet__empty">暂时没有内置组词，可以在下方补充。</view>

    <view class="word-sheet__section-title">补充孩子熟悉的词</view>
    <view class="word-sheet__input-row">
      <input
        class="word-sheet__input"
        maxlength="12"
        placeholder="例如：大象"
        value="{{inputValue}}"
        bindinput="onInput"
      />
      <button class="word-sheet__save" bindtap="onSaveCustomWord">添加</button>
    </view>
  </view>
</view>

