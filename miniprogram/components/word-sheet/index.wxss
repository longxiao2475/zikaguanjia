.word-sheet-mask {
  position: fixed;
  z-index: 1000;
  inset: 0;
  background: rgba(44, 44, 44, 0.42);
  display: flex;
  align-items: flex-end;
}

.word-sheet {
  position: relative;
  width: 100%;
  max-height: 82vh;
  padding: 20rpx 34rpx calc(38rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #FFFFFF;
  overflow-y: auto;
}

.word-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 12rpx;
  border-radius: 4rpx;
  background: #E4DFD9;
}

.word-sheet__close {
  position: absolute;
  top: 16rpx;
  right: 20rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 44rpx;
  color: #767676;
  background: #F6F3EF;
  font-size: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.word-sheet__close--pressed {
  opacity: 0.72;
}

.word-sheet__word {
  margin-top: 12rpx;
  text-align: center;
  font-size: 112rpx;
  font-weight: 720;
  line-height: 1.15;
}

.word-sheet__pinyin {
  margin-top: 4rpx;
  color: #E6704A;
  text-align: center;
  font-size: 34rpx;
}

.word-sheet__section-title {
  margin-top: 34rpx;
  font-size: 28rpx;
  font-weight: 680;
}

.word-sheet__tags {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.word-sheet__tag {
  min-height: 64rpx;
  padding: 10rpx 22rpx;
  border-radius: 32rpx;
  color: #7D3D2A;
  background: #FFF0EB;
  font-size: 27rpx;
}

.word-sheet__empty {
  margin-top: 14rpx;
  color: #A6A6A6;
  font-size: 25rpx;
}

.word-sheet__input-row {
  margin-top: 16rpx;
  display: flex;
  gap: 14rpx;
}

.word-sheet__input {
  min-width: 0;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 2rpx solid #F0EDE8;
  border-radius: 24rpx;
  color: #2C2C2C;
  caret-color: #E6704A;
  background: #FAF8F5;
  flex: 1;
  font-size: 28rpx;
}

.word-sheet__save {
  width: 150rpx;
  min-height: 88rpx;
  border-radius: 24rpx;
  color: #FFFFFF;
  background: #E6704A;
  font-size: 28rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}
