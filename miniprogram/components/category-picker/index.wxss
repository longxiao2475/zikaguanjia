.category-picker-mask {
  position: fixed;
  z-index: 1400;
  inset: 0;
  background: rgba(44, 44, 44, 0.46);
  display: flex;
  align-items: flex-end;
}

.category-picker {
  width: 100%;
  max-height: 82vh;
  padding: 20rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 38rpx 38rpx 0 0;
  background: #FFFFFF;
  box-sizing: border-box;
  overflow-y: auto;
}

.category-picker__handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 16rpx;
  border-radius: 4rpx;
  background: #E4DFD9;
}

.category-picker__header {
  min-height: 88rpx;
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
  align-items: center;
  gap: 12rpx;
}

.category-picker__title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}

button.category-picker__header-button {
  width: 100%;
  min-width: 0;
  max-width: 100%;
  min-height: 88rpx;
  color: #767676;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.category-picker__header-button--primary {
  color: #E6704A;
  font-weight: 650;
}

.category-picker__chips {
  padding: 18rpx 0 8rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

button.category-picker__chip {
  width: auto;
  max-width: 100%;
  min-height: 76rpx;
  padding: 0 24rpx;
  border: 2rpx solid #F0EDE8;
  border-radius: 38rpx;
  color: #767676;
  background: #FCFBF9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
}

.category-picker__chip--selected {
  border-color: #FF8A65;
  color: #C75C39;
  background: #FFF0EB;
}

.category-picker__empty {
  padding: 38rpx 0;
  color: #A6A6A6;
  text-align: center;
  font-size: 25rpx;
}

.category-picker__footer {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

button.category-picker__manage,
button.category-picker__clear,
button.category-picker__rename,
button.category-picker__add {
  max-width: 100%;
  min-height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 650;
}

button.category-picker__manage,
button.category-picker__add {
  color: #E6704A;
  background: #FFF0EB;
}

button.category-picker__clear {
  color: #767676;
}

.category-picker__manage-list {
  padding-top: 12rpx;
}

.category-picker__manage-row {
  min-height: 92rpx;
  border-bottom: 2rpx solid #F0EDE8;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.category-picker__manage-name {
  min-width: 0;
  flex: 1;
  font-size: 27rpx;
}

button.category-picker__rename {
  width: 120rpx;
  max-width: 100%;
  color: #E6704A;
}

button.category-picker__add {
  width: 100%;
  max-width: 100%;
  margin-top: 24rpx;
}
